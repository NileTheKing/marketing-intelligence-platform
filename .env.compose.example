DB_USERNAME=axon_user
DB_PASSWORD=replace-with-random-app-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
MYSQL_DATABASE=axon_db
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/axon_db?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
REDIS_PASSWORD=replace-with-random-redis-password
JWT_SECRET=replace-with-random-jwt-secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
AXON_ADMIN_EMAILS=
PAYMENT_TOKEN_SECRET=replace-with-random-payment-token-secret
# Payment v2 is opt-in, for explicitly selected new activities only.
# Apply the payment migration first; use the DB shared with Core.
AXON_PAYMENT_V2_ENABLED=false
AXON_PAYMENT_V2_ACTIVITY_IDS=
AXON_PAYMENT_V2_JDBC_URL=
AXON_PAYMENT_V2_DB_USER=
AXON_PAYMENT_V2_DB_PASSWORD=
GEMINI_API_KEY=
AXON_ENTRY_SERVICE_URL=http://entry-service:8081
AXON_CORE_SERVICE_BASE_URL=http://core-service:8080
AXON_CORS_ALLOWED_ORIGINS=https://axon.opicnic.xyz
SPRING_KAFKA_BOOTSTRAP_SERVERS=broker_1:29092
MANAGEMENT_HEALTH_ELASTICSEARCH_ENABLED=false
ES_JAVA_OPTS=-Xms1g -Xmx1g
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
CORE_JAVA_TOOL_OPTIONS=
ENTRY_JAVA_TOOL_OPTIONS=
GRAFANA_ADMIN_PASSWORD=admin
