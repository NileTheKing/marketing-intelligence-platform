server {
    listen 80;
    server_name axon.opicnic.xyz;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    access_log /var/log/nginx/axon_timing.log axon_timing;
    access_log /var/log/nginx/axon_observability.json.log axon_observability_json;
    server_name axon.opicnic.xyz;

    ssl_certificate     /etc/cloudflare/origin.pem;
    ssl_certificate_key /etc/cloudflare/private.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location / {
        proxy_pass http://axon_nginx;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;

        proxy_connect_timeout 90;
        proxy_send_timeout    90;
        proxy_read_timeout    90;
    }

    location /api/v1/dashboard/stream/ {
        proxy_pass http://axon_nginx;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;

        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
    }
}
