{
  "annotations": { "list": [] },
  "editable": true,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=~\"axon-entry|axon-core\"}[1m]))", "legendFormat": "HTTP requests/s", "refId": "A" },
        { "expr": "sum(rate(axon_pipeline_flush_seconds_count{application=\"axon-core\"}[1m]))", "legendFormat": "Core records/s", "refId": "B" },
        { "expr": "sum(rate(axon_triage_cases_total{outcome=\"claimed\"}[1m]))", "legendFormat": "AI cases/s", "refId": "C" }
      ],
      "title": "Traffic",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"axon-entry\"}[5m])))", "legendFormat": "Entry p95", "refId": "A" }],
      "title": "Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{application=~\"axon-entry|axon-core\",status=~\"5..\"}[5m]))", "legendFormat": "HTTP 5xx/s", "refId": "A" },
        { "expr": "sum(rate(axon_pipeline_dlt_routed_total[5m]))", "legendFormat": "DLT routed/s", "refId": "B" },
        { "expr": "sum(rate(axon_triage_llm_calls_total{outcome=\"failure\"}[5m]))", "legendFormat": "AI LLM failure/s", "refId": "C" }
      ],
      "title": "Errors",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        { "expr": "hikaricp_connections_pending{application=\"axon-core\"}", "legendFormat": "Hikari pending", "refId": "A" },
        { "expr": "sum(kafka_consumer_fetch_manager_records_lag{application=\"axon-core\"})", "legendFormat": "Kafka lag", "refId": "B" },
        { "expr": "max(executor_queued_tasks{application=\"axon-entry\",name=\"backendEventTaskExecutor\"})", "legendFormat": "Entry event queue", "refId": "C" },
        { "expr": "max(process_cpu_usage{application=~\"axon-entry|axon-core\"})", "legendFormat": "JVM process CPU", "refId": "D" }
      ],
      "title": "Saturation",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "tags": ["golden-signals", "axon"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Axon Golden Signals",
  "uid": "axon-golden-signals",
  "version": 1
}
